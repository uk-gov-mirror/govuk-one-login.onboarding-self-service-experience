{
  "name": "gds-di-self-service-common",
  "description": "DI Self-Service monorepo",
  "type": "module",
  "workspaces": [
    "backend/api",
    "backend/cognito",
    "express",
    "exampleotp-tests"
  ],
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "build-express": "npm run build -w express",
    "build-docker": "npm run build-docker -w express --",
    "build": "infrastructure/dev/deploy.sh --no-deploy",
    "deploy": "infrastructure/dev/deploy.sh",
    "docker": "npm run docker -w express --",
    "local": "npm run local -w express",
    "dev": "npm run dev -w express",
    "devtest": "concurrently -k -p \"[{name}]\" -n \"Sass,TypeScript,Node\" -c \"cyan.bold,green.bold\" \"npm run watch-ts\" \"npm run watch-node\"",
    "watch-node": "nodemon -r dotenv/config --inspect=0.0.0.0:3000 dist/app.js",
    "watch-sass": "sass --load-path=node_modules/govuk-frontend/dist/govuk --watch express/assets/css/app.scss dist/public/style.css",
    "watch-ts": "tsc -w",
    "buildtest": "npm run build-sass && npm run build-ts && npm run copy-assets",
    "build-dockertest": "docker build -t onboarding-self-service-experience-frontend .",
    "build-sass": "rm -rf dist/public/style.css && sass --load-path=node_modules/govuk-frontend/dist/govuk --no-source-map express/assets/css/app.scss dist/public/style.css --style compressed",
    "build-ts": "tsc",
    "copy-assets": "copyfiles -u 1 express/src/**/*.njk dist/ && npm run copy-scripts",
    "copy-scripts": "rm -r dist/public/scripts || true && mkdir -p dist/public/scripts && cp node_modules/govuk-frontend/dist/govuk/govuk-frontend.min.js dist/public/scripts",
    "aws": "npm run remote --",
    "remote": "infrastructure/dev/deploy.sh run",
    "delete": "infrastructure/dev/deploy.sh delete",
    "list": "infrastructure/dev/deploy.sh list",
    "open": "infrastructure/dev/deploy.sh open",
    "creds": "infrastructure/aws.sh",
    "test": "vitest run --passWithNoTests",
    "test:express": "vitest run --passWithNoTests ./express/tests --config express/vitest.config.ts",
    "test:backend": "vitest run --passWithNoTests ./backend",
    "test:cov": "vitest run --coverage",
    "lint": "eslint . --max-warnings=0 && prettier --check \"**/*.{ts,json}\"",
    "lint:fix": "prettier . --write ; eslint . --fix",
    "pii-scan": "infrastructure/dev/pii_scan.sh -p *template*.yml -i infrastructure/config/pii_scan_ignore.txt -s infrastructure/config/pii_scan_skip.txt"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1134.0",
    "@aws-sdk/client-sqs": "^3.1134.0",
    "@pact-foundation/pact": "^16.3.0",
    "axios": "^1.20.0",
    "concurrently": "^10.0.7",
    "googleapis": "^178.1.1",
    "helmet": "^8.3.0",
    "jiti": "^2.7.0",
    "nodemon": "^3.1.14",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@types/aws-lambda": "^8.10.163",
    "@types/fs-extra": "^11.0.4",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^4.2.1",
    "fs-extra": "^11.4.0",
    "prettier": "^2.8.8",
    "ts-node": "^10.9.1",
    "typescript": "^5.8.3"
  }
}
